### Flight Assistant API — IntelliJ HTTP Client
### src/test/http/http-client.private.env.json:
### {
###   "local": {
###     "userEmail": "your-user@example.com",
###     "userPassword": "your-password",
###     "flightId": 1,
###     "outboundSeatId": 1,
###     "bookingId": 1,
###     "passengerFirstName": "Test",
###     "passengerLastName": "Passenger",
###     "passengerPassportNumber": "TEST123456"
###   }
### }
### Select the "local" environment before running authenticated requests.

@baseUrl = http://localhost:8080
@origin = Gothenburg
@destination = Paris
@departureDate = 2026-09-11

### 1. Public chat — creates a conversation
POST {{baseUrl}}/api/assistant/chat
Content-Type: application/json

{
  "conversationId": null,
  "message": "Hello. What can you help me with?"
}

> {%
    client.test("Public chat returns a conversation", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.conversationId, "conversationId is missing");
    });
    client.global.set("publicConversationId", response.body.conversationId);
%}

### 2. Public tool — search airports
POST {{baseUrl}}/api/assistant/chat
Content-Type: application/json

{
  "conversationId": "{{publicConversationId}}",
  "message": "Search for airports in {{origin}}"
}

> {%
    client.test("Airport search returns structured data", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body.airports), "airports must be an array");
    });
%}

### 3. Public tool — search available flights
### Change the cities/date above if they do not match your demonstration data.
POST {{baseUrl}}/api/assistant/chat
Content-Type: application/json

{
  "conversationId": "{{publicConversationId}}",
  "message": "Find available flights from {{origin}} to {{destination}} on {{departureDate}}"
}

> {%
    client.test("Flight search returns structured data", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body.flights), "flights must be an array");
    });
%}

### 4. Public tool — get available seats
POST {{baseUrl}}/api/assistant/chat
Content-Type: application/json

{
  "conversationId": "{{publicConversationId}}",
  "message": "Show the available seats for flight ID {{flightId}}"
}

> {%
    client.test("Seat search returns structured data", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body.availableSeats), "availableSeats must be an array");
    });
%}

### 5. Protected tool without JWT — should request authentication
POST {{baseUrl}}/api/assistant/chat
Content-Type: application/json

{
  "conversationId": null,
  "message": "Show my bookings"
}

> {%
    client.test("Anonymous personal request requires authentication", function () {
        client.assert(response.status === 200, "Expected assistant response envelope");
        client.assert(response.body.type === "AUTHENTICATION_REQUIRED",
            "Expected AUTHENTICATION_REQUIRED");
    });
%}

### 6. Login — saves JWT for subsequent requests
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

> {%
    client.test("Login returns a JWT", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.token, "JWT token is missing");
    });
    client.global.set("accessToken", response.body.token);
%}

### 7. Authenticated tool — get my bookings
POST {{baseUrl}}/api/assistant/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "conversationId": null,
  "message": "Show my active bookings"
}

> {%
    client.test("Booking search returns structured data", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body.bookings), "bookings must be an array");
    });
    client.global.set("authenticatedConversationId", response.body.conversationId);
%}

### 8. Prepare cancellation — must NOT cancel immediately
### bookingId must belong to the authenticated user.
POST {{baseUrl}}/api/assistant/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "conversationId": "{{authenticatedConversationId}}",
  "message": "Cancel my booking with ID {{bookingId}}"
}

> {%
    client.test("Cancellation requires confirmation", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.requiresConfirmation === true,
            "Expected requiresConfirmation=true");
        client.assert(response.body.pendingAction, "pendingAction is missing");
        client.assert(response.body.pendingAction.type === "CANCEL_BOOKING",
            "Expected CANCEL_BOOKING");
    });
    if (response.body.pendingAction) {
        client.global.set("cancelActionId", response.body.pendingAction.actionId);
    }
%}

### 9A. Confirm cancellation — destructive; run only when intended
POST {{baseUrl}}/api/assistant/conversations/{{authenticatedConversationId}}/actions/{{cancelActionId}}/confirm
Authorization: Bearer {{accessToken}}

> {%
    client.test("Cancellation confirmation succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.requiresConfirmation === false,
            "Confirmed action must not remain pending");
    });
%}

### 9B. Reject cancellation instead of 9A
### Run request 8 again first to obtain a fresh action ID.
DELETE {{baseUrl}}/api/assistant/conversations/{{authenticatedConversationId}}/actions/{{cancelActionId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Cancellation rejection succeeds", function () {
        client.assert(response.status === 204, "Expected HTTP 204");
    });
%}

### 10. Prepare booking — must NOT create immediately
### Use IDs that exist and identify an available flight and seat.
POST {{baseUrl}}/api/assistant/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "conversationId": "{{authenticatedConversationId}}",
  "message": "Book a one-way trip on flight ID {{flightId}} using seat ID {{outboundSeatId}} for {{passengerFirstName}} {{passengerLastName}}, passport {{passengerPassportNumber}}, contact email {{userEmail}}"
}

> {%
    client.test("Booking requires confirmation", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.requiresConfirmation === true,
            "Expected requiresConfirmation=true");
        client.assert(response.body.pendingAction, "pendingAction is missing");
        client.assert(response.body.pendingAction.type === "CREATE_BOOKING",
            "Expected CREATE_BOOKING");
    });
    if (response.body.pendingAction) {
        client.global.set("bookingActionId", response.body.pendingAction.actionId);
    }
%}

### 11A. Confirm booking — creates real data; run only when intended
POST {{baseUrl}}/api/assistant/conversations/{{authenticatedConversationId}}/actions/{{bookingActionId}}/confirm
Authorization: Bearer {{accessToken}}

### 11B. Reject booking instead of 11A
DELETE {{baseUrl}}/api/assistant/conversations/{{authenticatedConversationId}}/actions/{{bookingActionId}}
Authorization: Bearer {{accessToken}}

### 12. Clear public conversation
DELETE {{baseUrl}}/api/assistant/conversations/{{publicConversationId}}

> {%
    client.test("Public conversation is cleared", function () {
        client.assert(response.status === 204, "Expected HTTP 204");
    });
%}

### 13. Clear authenticated conversation
DELETE {{baseUrl}}/api/assistant/conversations/{{authenticatedConversationId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Authenticated conversation is cleared", function () {
        client.assert(response.status === 204, "Expected HTTP 204");
    });
%}
